# Plantilla de Dockerfile compartida (Entrega 2, sección 4.1).
# Cada componente (api-gateway y cada microservicio) tiene su propio Dockerfile
# basado en esta plantilla; solo cambia el valor por defecto de PORT.

# ---------- Etapa 1: instalar dependencias de producción ----------
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# ---------- Etapa 2: imagen final, solo con lo necesario ----------
FROM node:20-alpine
ENV NODE_ENV=production
ARG PORT=8080
ENV PORT=${PORT}
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Seguridad: la imagen oficial trae el usuario "node", sin privilegios de root.
USER node

EXPOSE ${PORT}

# Docker marca el contenedor como "unhealthy" si /health/live deja de responder.
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -qO- "http://localhost:${PORT}/health/live" || exit 1

CMD ["node", "src/index.js"]
