# Plantilla de Dockerfile compartida (Entrega 2, sección 4.1).
# Cada componente tiene su propio Dockerfile (services/<servicio>/Dockerfile) copiado
# de esta plantilla, reemplazando <servicio> y <puerto>.
#
# El contexto de construcción es la RAÍZ del repositorio, para que la imagen pueda
# incluir su contrato de docs/openapi/ y servirlo en /docs (RNF13):
#   docker build -f services/<servicio>/Dockerfile -t logitech/<servicio>:1.0.0 .

# ---------- Etapa 1: instalar solo dependencias de producción ----------
FROM node:20-alpine AS deps
WORKDIR /app
COPY services/<servicio>/package.json services/<servicio>/package-lock.json ./
RUN npm ci --omit=dev

# ---------- Etapa 2: imagen final, solo con lo necesario ----------
FROM node:20-alpine
ENV NODE_ENV=production \
    PORT=<puerto> \
    OPENAPI_PATH=/app/openapi.yaml
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY services/<servicio>/package.json ./
COPY services/<servicio>/src ./src
COPY services/<servicio>/migrations ./migrations
COPY docs/openapi/<servicio>.yaml ./openapi.yaml

# Seguridad: la imagen oficial trae el usuario "node", sin privilegios de root.
USER node

EXPOSE <puerto>

# Docker marca el contenedor como "unhealthy" si /health/live deja de responder.
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -qO- "http://localhost:${PORT}/health/live" || exit 1

CMD ["node", "src/index.js"]
