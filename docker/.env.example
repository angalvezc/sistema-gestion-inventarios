# Copia este archivo como docker/.env y cambia los valores antes de levantar el entorno:
#   cp docker/.env.example docker/.env
# El archivo .env real NO se sube a GitHub (está en .gitignore).

# --- Bases de datos (una por microservicio, RNF02) ---
DB_AUTH_USER=app_auth
DB_AUTH_PASSWORD=cambiar_auth

DB_PRODUCTS_USER=app_products
DB_PRODUCTS_PASSWORD=cambiar_products

DB_STOCK_USER=app_stock
DB_STOCK_PASSWORD=cambiar_stock

DB_SUPPLIERS_USER=app_suppliers
DB_SUPPLIERS_PASSWORD=cambiar_suppliers

DB_PURCHASES_USER=app_purchases
DB_PURCHASES_PASSWORD=cambiar_purchases

DB_AUDIT_USER=app_audit
DB_AUDIT_PASSWORD=cambiar_audit

# --- RabbitMQ (RNF08) ---
RABBITMQ_USER=logitech
RABBITMQ_PASSWORD=cambiar_rabbit

# --- Seguridad JWT (RNF07) ---
# Secreto compartido solo por ms-auth-users (firma) y api-gateway (verifica).
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
