# Variables del API Gateway (Laravel).
# En Docker/Kubernetes se pasan como variables de entorno (docker-compose.yml);
# este archivo solo sirve para correrlo localmente: cp .env.example .env

APP_NAME=api-gateway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# El gateway no usa base de datos ni sesiones.
DB_CONNECTION=sqlite
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# El rate limiter guarda sus contadores en archivos (storage/framework/cache).
CACHE_STORE=file

# --- Seguridad (RNF07): mismo secreto que ms-auth-users (mínimo 32 caracteres) ---
JWT_SECRET=

# --- Microservicios (Service Discovery) ---
AUTH_URL=http://ms-auth-users:8081
PRODUCTS_URL=http://ms-products:8082
STOCK_URL=http://ms-inventory-stock:8083
SUPPLIERS_URL=http://ms-suppliers:8084
PURCHASES_URL=http://ms-purchases:8085
AUDIT_URL=http://ms-returns-audit:8086

UPSTREAM_TIMEOUT=10
RATE_LIMIT_MAX=600

# En Kubernetes, detrás del Ingress: TRUSTED_PROXIES=*
TRUSTED_PROXIES=
